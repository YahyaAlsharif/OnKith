{
  "moonshine": {
    "language": "en",
    "model_arch": "medium_streaming",
    "package_version": "0.0.69",
    "session_policy": "isolated_cached_resources",
    "rnnoise_enabled": false,
    "chunk_seconds": 0.1,
    "update_interval_seconds": 0.25,
    "vad_threshold": 0.5,
    "vad_window_duration_seconds": 0.3,
    "vad_max_segment_duration_seconds": 10.0,
    "max_tokens_per_second": 6.5
  },
  "audio": {
    "calibration_seconds": 2.0,
    "pre_roll_seconds": 0.4,
    "start_confirm_seconds": 0.2,
    "endpoint_silence_seconds": 2.5,
    "minimum_speech_seconds": 0.6,
    "maximum_utterance_seconds": 8.5,
    "minimum_start_rms": 0.006,
    "maximum_start_rms": 0.15,
    "noise_multiplier": 4.0,
    "continue_ratio": 0.6,
    "queue_max_chunks": 100,
    "completed_recording_queue_max": 4,
    "forced_split_overlap_seconds": 0.35,
    "trailing_silence_context_seconds": 0.35,
    "speech_tail_seconds": 0.35,
    "save_debug_audio": false
  },
  "buffer": {
    "inactivity_seconds": 3.0,
    "maximum_tokens": 256,
    "maximum_duration_seconds": 15.0
  },
  "wake": {
    "names": [
      "onkith",
      "sada",
      "sitr",
      "echo"
    ],
    "spellings": [
      "onkuth",
      "onkoth",
      "onketh",
      "unkith",
      "onkit",
      "onket",
      "onkiss",
      "ownkiss",
      "onkis",
      "onkeys",
      "\u0635\u062f\u0649",
      "sitter",
      "setter",
      "\u0633\u062a\u0631"
    ],
    "never": [
      "ankit",
      "ankith"
    ],
    "fuzzy_minimum_length": 6,
    "edit_distance": 1
  },
  "stt": {
    "engine": "whisper",
    "whisper": {
      "model": "base.en",
      "compute_type": "int8",
      "beam_size": 5
    }
  },
  "stage5": {
    "mode": "immediate"
  },
  "storage": {
    "filename": "session_transcript.db",
    "journal_mode": "WAL",
    "synchronous": "NORMAL",
    "foreign_keys": true,
    "busy_timeout_ms": 5000
  },
  "pii": {
    "engine": "deberta",
    "engines": {
      "deberta": {
        "model": "OnKith Model V2 - DeBERTa-v3-xsmall token classifier, INT8",
