    "provider": "CPUExecutionProvider",
    "context_limit": 512,
    "overflow_stride": 128,
    "word_policy": "whole_word_union",
    "structured_enabled": true,
    "never_mask": [
      "CITY",
      "COUNTRY",
      "TIMEZONE",
      "TIME",
      "TITLE"
