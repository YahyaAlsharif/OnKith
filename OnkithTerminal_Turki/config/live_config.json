        "model_id": "microsoft/deberta-v3-xsmall",
        "ontology_version": "model_v2.ontology.1",
        "artifact": "models/deberta_pii/model_int8.onnx",
        "tokenizer": "models/deberta_pii/tokenizer",
        "label_map": "models/deberta_pii/config/model_v2_label_map.json",
        "manifest": "models/deberta_pii/model_manifest.json",
        "sha256": "bc8d1d7a7fb14304e195e47079c3dbb330c627ea4c9753f3af667676048106a8",
        "size_bytes": 82278782,
        "label_count": 63
      },
      "tinybert": {
        "model": "OnKith Model V1 - TinyBERT-4 token classifier, INT8",
