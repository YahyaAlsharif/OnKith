# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
*/.venv/

# ---------------------------------------------------------------------------
# Python bytecode and build artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Test, coverage, and type-checker caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
test-results/
test_output/
*.test.json

# ---------------------------------------------------------------------------
# Logs and local run output
# ---------------------------------------------------------------------------
*.log
logs/
runtime/
*.pid

# ---------------------------------------------------------------------------
# Model caches and downloaded weights (models are vendored explicitly)
# ---------------------------------------------------------------------------
.cache/
.huggingface/
huggingface/
model_cache/
*.ort.cache

# Hugging Face cache created by the model/data dataset builders. Both notebooks
# default HF_HOME to "<cwd>/.pii_hf_cache", which holds multi-gigabyte source
# corpora (OpenPII 1.5M, Gretel, Nemotron) that are always re-downloadable.
.pii_hf_cache/

# Research artifacts that are regenerated by the training notebooks
model/TinyBERT-4/artifacts/tinybert_pii/checkpoints/
model/TinyBERT-4/artifacts/tinybert_pii/huggingface_model/
model/TinyBERT-4/artifacts/tinybert_pii/onnx_model/model_fp32.onnx

# ---------------------------------------------------------------------------
# Generated PII corpora (model/data)
# ---------------------------------------------------------------------------
# Every corpus produced under model/ is a large local artifact regenerated from
# pinned sources plus committed metadata. Only the generators and their docs are
# tracked, so a new generated filename cannot be committed by accident.
model/data/*
!model/data/*.ipynb
!model/data/*.md
!model/data/.gitignore
!model/data/saudi_mena_pii_manifest.json
model/data/.*_execution.ipynb

# ---------------------------------------------------------------------------
# Captured audio and transcripts — never commit recorded speech
# ---------------------------------------------------------------------------
*.wav
*.flac
*.raw
moonshine_received_audio/
transcripts/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editor and OS files
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
