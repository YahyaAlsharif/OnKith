# Normalize text files in the repository.
* text=auto

# Shell scripts must keep LF endings. This repository is developed on Windows
# (where core.autocrlf=true is common) and deployed to Raspberry Pi OS. A CRLF
# shell script fails on Linux with an opaque "\r: command not found".
*.sh text eol=lf

# PowerShell is Windows-side; CRLF is the native convention there.
*.ps1 text eol=crlf

# Hash-identified evaluation fixtures. Their manifests record a SHA-256 of the
# file bytes, and the frozen OOD final benchmark refuses to run when that hash
# does not match, so a CRLF checkout on Windows silently invalidates the
# artifact identity the release procedure depends on. `-text` disables all
# end-of-line conversion, which is what makes a Windows workstation and a
# Raspberry Pi hash the same bytes.
model/privacy_evaluation/fixtures/**/*.jsonl -text
model/privacy_evaluation/fixtures/*.manifest.json -text
model/privacy_evaluation/fixtures/**/*.manifest.json -text

# Binary assets must never be line-ending converted.
*.onnx binary
*.ort binary
*.bin binary
*.safetensors binary
*.wav binary
*.flac binary
*.png binary
*.jpg binary
*.pyc binary

# Large vendored model artifacts are not useful in diffs.
*.onnx -diff
*.safetensors -diff
