{
  "dataset_name": "ai4privacy/pii-masking-300k",
  "source_column": "source_text",
  "label_sources": [
    "privacy_mask",
    "span_labels"
  ],
  "target_text_usage": "reference_only_not_training_input",
  "language_filter": "en",
  "text_truncation": "disabled",
  "padding": "dynamic per batch in collate_batch",
  "token_pattern": "[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}|\\d+[\\d.,:/+-]*|[A-Za-z]+(?:[-'][A-Za-z]+)*|\\w+|[^\\w\\s]",
  "token_feature_rules": [
    "EMAIL_PATTERN",
    "NUMBER_PATTERN",
    "ALNUM_PATTERN",
    "lowercase fallback"
  ],
  "label_format": "type-specific BIO labels from privacy_mask/span_labels"
}